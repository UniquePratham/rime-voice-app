# Rime Hackathon submission — Spotter
#
# Copy to .env.local (never commit .env.local).
# All values below are placeholders except NEXT_PUBLIC_* which default to false.

# REQUIRED — Rime API credentials (server-side only, never in the browser).
RIME_API_KEY=

# Optional — override Rime HTTP-TTS endpoint, model, and speaker.
# Defaults: endpoint=https://users.rime.ai/v1/rime-tts, model=mistv2, speaker=astra
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_MODEL=mistv2
RIME_SPEAKER=astra

# Optional — OpenAI / compatible key used for free-form intent parsing
# (OPENAI_-namespaced). If empty, the deterministic local intent parser is used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional public flags. These ship to the browser and are safe.
NEXT_PUBLIC_SHOW_EVAL_PANEL=false
NEXT_PUBLIC_ENABLE_MIC=true